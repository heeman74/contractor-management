# Required
DATABASE_URL=postgresql+asyncpg://appuser:apppassword@postgres:5432/contractorhub
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
POSTGRES_PASSWORD=change-me

# Optional
POSTGRES_DB=contractorhub
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=https://yourdomain.com
ANTHROPIC_API_KEY=sk-ant-...
APP_ENV=production
LOG_LEVEL=INFO
FASTAPI_URL=http://backend:8000

# Public base URL used to build client-facing links (password-reset emails,
# magic-link /sign pages). MUST be the real origin in production — the default
# is http://localhost:3000, which silently produces unusable reset links.
PUBLIC_WEB_URL=https://yourdomain.com

# SMTP transport for transactional email (password reset).
# CRITICAL: when SMTP_HOST is unset the app runs in dev mode and does NOT send
# email — it only logs the message. Password reset appears to work and silently
# delivers nothing. Set these for any real deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=ContractorHub <no-reply@yourdomain.com>
