# ContractorHub Backend — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.

# Required — app will crash without these
DATABASE_URL=postgresql+asyncpg://appuser:apppassword@localhost:5432/contractorhub
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars

# Optional
REDIS_URL=redis://localhost:6379/0
DEBUG=false
CORS_ORIGINS=http://localhost:3000

# Public base URL for client-facing links (password-reset emails, /sign pages).
PUBLIC_WEB_URL=http://localhost:3000

# SMTP. Leave SMTP_HOST empty in local dev: the app then logs reset emails
# instead of sending them (read the link from the backend logs). Set it for
# any deployment where email must actually arrive.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=ContractorHub <no-reply@contractorhub.local>
